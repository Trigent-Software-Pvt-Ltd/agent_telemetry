# Database (RDS PostgreSQL)
DATABASE_URL=postgresql://user:password@your-rds-endpoint.amazonaws.com:5432/agent_telemetry

# Auth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Redis (ElastiCache)
REDIS_URL=redis://your-elasticache-endpoint.amazonaws.com:6379

# Cron security
CRON_SECRET=generate-a-random-secret-here

# Langfuse (optional — configure per org in settings)
# Individual org Langfuse credentials are stored encrypted in the database

# Data source (mock or db)
DATA_SOURCE=mock
