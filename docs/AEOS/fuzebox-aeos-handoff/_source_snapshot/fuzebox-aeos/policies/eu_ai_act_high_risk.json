{
  "id": "eu_ai_act_high_risk",
  "version": "2026.04",
  "description": "EU AI Act Annex-III high-risk systems — human oversight, audit log, and evidence export required.",
  "rules": [
    {
      "id": "human_in_loop_required",
      "severity": "critical",
      "when": {"task.risk_level": ["high", "critical"]},
      "require": {"path.human_involved": true}
    },
    {
      "id": "audit_log_mandatory",
      "severity": "high",
      "when": {"always": true},
      "require": {"governance.audit_log_required": true, "governance.trace_retention_days_min": 365}
    },
    {
      "id": "evidence_export_required",
      "severity": "high",
      "when": {"task.risk_level": ["high", "critical"]},
      "require": {"governance.evidence_export_required": true}
    },
    {
      "id": "human_override_available",
      "severity": "high",
      "when": {"always": true},
      "require": {"governance.human_override_available": true}
    },
    {
      "id": "explainability_required_on_high_risk",
      "severity": "high",
      "when": {"task.risk_level": ["high", "critical"]},
      "require": {
        "governance.trace_retention_days_min": 730,
        "governance.explainability_required": true
      }
    }
  ]
}
