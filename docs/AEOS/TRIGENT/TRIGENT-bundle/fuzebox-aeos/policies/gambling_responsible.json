{
  "id": "gambling_responsible",
  "version": "2026.04",
  "description": "Responsible-play envelope for regulated sportsbook / casino work.",
  "rules": [
    {
      "id": "audit_log_required",
      "severity": "high",
      "when": {"always": true},
      "require": {"governance.audit_log_required": true, "governance.trace_retention_days_min": 180}
    },
    {
      "id": "human_override_available",
      "severity": "high",
      "when": {"task.regulatory_class": ["gambling"]},
      "require": {"governance.human_override_available": true}
    }
  ]
}
